{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/refs/heads/main/packages/wrangler/config-schema.json",
  "name": "whisper-openai-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "TRIAL_USAGE", "class_name": "TrialUsageGateway" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TrialUsageGateway"] }
  ],
  "observability": {
    "enabled": true
  }
}
